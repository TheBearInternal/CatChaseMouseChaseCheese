# =============================================================================
# hft_lab — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your credentials.
#   cp .env.template .env
#
# NEVER commit .env to version control.
# NEVER share your secret key or API key with anyone.
# =============================================================================

# -----------------------------------------------------------------------------
# Alpaca Markets API Credentials
# Obtain at: https://alpaca.markets → Paper Trading or Live Trading → API Keys
# -----------------------------------------------------------------------------
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Trading endpoint URL.
# Paper trading (safe — no real money at risk):
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Live trading (REAL MONEY — use only after thorough paper testing):
# ALPACA_BASE_URL=https://api.alpaca.markets

# Market data stream endpoint
ALPACA_DATA_URL=https://data.alpaca.markets

# -----------------------------------------------------------------------------
# News API
# Obtain at: https://newsapi.org → Get API Key
# -----------------------------------------------------------------------------
NEWS_API_KEY=your_news_api_key_here

# -----------------------------------------------------------------------------
# Symbols
# -----------------------------------------------------------------------------
# Primary symbol the strategy focuses on
PRIMARY_SYMBOL=AAPL

# Benchmark symbol used for relative performance comparisons
BENCHMARK_SYMBOL=SPY

# -----------------------------------------------------------------------------
# Behavioral Randomization
# -----------------------------------------------------------------------------
# Integer seed that controls all session-level timing and sizing variation.
# Change between sessions to vary patterns. Record seeds used for reproducibility.
# Recommended starting values: 42, 137, 2718, 31415
BEHAVIOR_SEED=42

# -----------------------------------------------------------------------------
# Risk & Account Parameters
# -----------------------------------------------------------------------------
# Maximum total capital exposed (USD). Acts as a hard ceiling on position value.
ACCOUNT_LIMIT=500

# Maximum fraction of account to risk on a single trade (e.g. 0.02 = 2%)
MAX_RISK_PER_TRADE_PCT=0.02

# Position sizing mode:
#   dynamic — size is calculated from MAX_RISK_PER_TRADE_PCT each trade
#   fixed   — always use FIXED_POSITION_SIZE shares
POSITION_MODE=dynamic

# Share count used when POSITION_MODE=fixed
FIXED_POSITION_SIZE=100

# Absolute floor on any position size regardless of mode.
# Fractional values are valid for crypto (e.g. 0.001 for BTC) and
# forex (e.g. 1000 for micro-lot sizing). Use 1 for equity shares.
MIN_POSITION_SIZE=1

# -----------------------------------------------------------------------------
# Execution Parameters
# -----------------------------------------------------------------------------
# Whether to widen/narrow entry spread based on current market spread
SPREAD_ADJUSTMENT_ENABLED=true

# Fraction of price added to fills to simulate market impact / slippage
SLIPPAGE_FACTOR=0.0001

# Minimum ratio of expected profit to bid-ask spread required to enter a trade
MIN_PROFIT_SPREAD_MULTIPLE=3

# =============================================================================
# Phase 2 — Trading Engine
# =============================================================================

# -----------------------------------------------------------------------------
# Development mode
# -----------------------------------------------------------------------------
# When true: bypasses behavioral startup delay, reduces warm-up to 30 bars,
# treats any time as market hours. Set to false for live/paper operation.
DEV_MODE=false

# -----------------------------------------------------------------------------
# Data configuration
# -----------------------------------------------------------------------------
# Number of historical minute bars to fetch at session warm-up
HISTORICAL_BARS=200

# Timeframe for historical bars (1Min, 5Min, 15Min, 1Hour)
BAR_TIMEFRAME=1Min

# -----------------------------------------------------------------------------
# Logging paths
# -----------------------------------------------------------------------------
TRADE_LOG_PATH=logs/trade_log.csv
SESSION_STATE_PATH=logs/session_state.json

# -----------------------------------------------------------------------------
# Ensemble decision thresholds
# -----------------------------------------------------------------------------
# Minimum absolute ensemble score to open a position in normal regime
ENSEMBLE_THRESHOLD=0.60

# Stricter threshold used when regime is ambiguous
ENSEMBLE_THRESHOLD_AMBIGUOUS=0.70

# Strictest threshold used in random-walk regime
ENSEMBLE_THRESHOLD_RANDOM=0.75

# -----------------------------------------------------------------------------
# Position limits
# -----------------------------------------------------------------------------
# Maximum number of simultaneously open positions
MAX_OPEN_POSITIONS=3

# -----------------------------------------------------------------------------
# News sentiment
# -----------------------------------------------------------------------------
# Seconds between NewsAPI polls
NEWS_POLL_INTERVAL=60

# -----------------------------------------------------------------------------
# Kalman filter (ensemble weight tracking)
# -----------------------------------------------------------------------------
KALMAN_PROCESS_NOISE=0.001
KALMAN_MEASUREMENT_NOISE=0.1

# -----------------------------------------------------------------------------
# Information coefficient
# -----------------------------------------------------------------------------
# Rolling window for signal prediction vs outcome correlation, per market type.
# Crypto trades faster so needs a shorter window; forex is intermediate.
IC_WINDOW_EQUITY=50
IC_WINDOW_CRYPTO=20
IC_WINDOW_FOREX=35

# -----------------------------------------------------------------------------
# GARCH volatility model
# -----------------------------------------------------------------------------
# Seconds between full GARCH re-fits on new returns data
GARCH_UPDATE_INTERVAL=300

# -----------------------------------------------------------------------------
# ATR-based stops and targets
# -----------------------------------------------------------------------------
ATR_PERIOD=14
ATR_STOP_MULTIPLIER=2.0
RISK_REWARD_RATIO=2.0
MIN_ATR_FOREX=0.0005
# Stop distance is widened to at least this multiple of the live spread
MIN_STOP_SPREAD_MULTIPLE=3.0
# Reject new forex entries when the spread exceeds this (0.00040 = 4 pips)
MAX_ENTRY_SPREAD=0.00040
# Forward-return horizon (bars) for continuous bar-level IC scoring
IC_FORWARD_BARS=5
# Warm-start IC/Kalman from historical bars at first startup
IC_WARM_START_ENABLED=true
# Max |weight| any single signal may hold after L1 normalization
MAX_SIGNAL_WEIGHT=0.6
# Regimes in which new entries are allowed (comma-separated; empty disables gate)
TRADEABLE_REGIMES=TRENDING,MEAN_REVERTING
# New-entry windows in America/New_York, HH:MM-HH:MM comma-separated
# (empty disables; ranges may cross midnight)
TRADING_SESSIONS=08:00-12:00
# Seconds to block re-entry on an instrument after a close (signal_reversal exempt)
POST_CLOSE_COOLDOWN_S=300

# =============================================================================
# Phase 6 — Universal Engine (Multi-Market Support)
# =============================================================================

# -----------------------------------------------------------------------------
# Market type
# -----------------------------------------------------------------------------
# Accepted values: equity | crypto | forex
#   equity — US equities via IEX/SIP feed, NYSE/NASDAQ market hours (9:30–16:00 EST)
#   crypto — Digital assets via Alpaca crypto feed, 24/7 trading, no session close
#   forex  — Currency pairs via OANDA v20 API, 24/5 (Sun 17:00–Fri 17:00 EST)
# Switching markets requires ONLY changes in this file — zero code modifications.
MARKET_TYPE=equity

# Benchmark symbol used when MARKET_TYPE=crypto
# For equity the BENCHMARK_SYMBOL above is used instead.
CRYPTO_BENCHMARK=BTC/USD

# -----------------------------------------------------------------------------
# Phase 6 — OANDA Forex (set MARKET_TYPE=forex to activate)
# -----------------------------------------------------------------------------
# Personal access token from hub.oanda.com → Manage API Access
# Never share or commit this value.
OANDA_API_KEY=your_personal_token_here
# Account ID from hub.oanda.com/accounts — use the V20 account
OANDA_ACCOUNT_ID=001-001-XXXXXXX-XXX
# live = real OANDA account | practice = OANDA demo account
OANDA_ENVIRONMENT=live
# Benchmark currency pair for relative strength signal (OANDA format: XXX_YYY)
FOREX_BENCHMARK=GBP_USD

# =============================================================================
# News Strategy — FinBERT + Economic Calendar
# =============================================================================

# -----------------------------------------------------------------------------
# Reddit sentiment (optional)
# -----------------------------------------------------------------------------
# Set to true to enable Reddit as a secondary sentiment source via praw.
# Requires REDDIT_CLIENT_ID and REDDIT_CLIENT_SECRET below.
REDDIT_SENTIMENT_ENABLED=false

# Reddit API credentials — obtain at https://www.reddit.com/prefs/apps
# Create a "script" type app; the client ID is shown under the app name.
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
